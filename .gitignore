# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（白名单 .env.local.example 提交仓库作为配置模板）
.env
.env.*
!.env.local.example

# deploy 本地配置与依赖（deploy/.env 含 VPS 凭据，务必忽略；模板 .env.example 需提交）
/deploy/.env
!/deploy/.env.example
/deploy/*.log

# CH 数据管道运行时产物（SQLite 数据库与生成的 fixture）
/data
/scripts/ch-sync/mock/sample-snapshot.csv
/scripts/ch-sync/mock/sample-events.ndjson

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 用户本机临时保存的网页快照（不进入仓库）
/登录界面/

# VPS 配置密钥本地备份（含真实 .env.local 与 env-config.json，严禁入库）
/config-backup/
