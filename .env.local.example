# ===== qxx.uk 环境变量模板 =====
# 复制为 .env.local 并填入真实值

# ---- 必填：官方 API ----
# Companies House 开发者 Key（免费）
# 注册: https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# ---- 可选：Redis 缓存 ----
# 留空则使用进程内内存缓存（单实例/本地开发）
# 生产建议用 Upstash Serverless 或自建 Redis
REDIS_URL=

# ---- 站点 ----
# 生产域名（用于 canonical / sitemap / og）
NEXT_PUBLIC_SITE_URL=https://qxx.uk
NEXT_PUBLIC_CONTACT_EMAIL=ai@qxx.uk

# ---- 分卷 sitemap / pSEO 数据源（可选）----
# scripts/ch-sync 管道产出的公司库；未配置时 sitemap 回退种子数据（仅收录热门公司）。
# SQLite（推荐，VPS 需 Node >= 22.5）或 PostgreSQL 二选一：
CH_SITEMAP_DB=data/ch-companies.db
# CH_SITEMAP_DB_URL=postgres://user:pass@host:5432/dbname

# ---- 公司详情页本地直读（可选，强烈推荐启用）----
# 指向 ch-sync 管道产出的同一份公司库：命中时详情页/API 毫秒直读、零消耗 CH REST 配额，
# 未命中才回源官方 API。留空则始终走官方 API（现状）。
CH_LOCAL_DB=data/ch-companies.db
# CH_LOCAL_DB_URL=postgres://user:pass@host:5432/dbname

# ---- 毫秒级搜索补全（Meilisearch，可选）----
# 未配置时搜索框保持"提交到结果页"的既有行为；配置后输入前 2-3 个字母即时呈现 Top 8 下拉。
# 索引 settings 与数据同步见 scripts/search/（`npm run ms:settings` / `npm run ms:sync`）。
# 本地一键起服务：`docker run -p 7700:7700 getmeili/meilisearch --master-key=<保密码>`
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=your_master_or_search_key
MEILISEARCH_INDEX=companies

# ---- 变现（未配置则相关模块自动隐藏）----
# Google AdSense 发布商 ID（格式 ca-pub-xxxx；本站：ca-pub-8629889510424643）
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8629889510424643
# Cookie-Script CMP 站点 ID（UK GDPR 合规）。
# 后台复制到的脚本形如 https://cdn.cookie-script.com/s/<此ID>.js
# 本站：d07e95a8ec9f00ea51dc2c981aa14e6b
NEXT_PUBLIC_COOKIESCRIPT_ID=

# 联盟营销（B2B 佣金）—— 填入你的推广链接，留空自动隐藏
NEXT_PUBLIC_TIDE_AFFILIATE=
NEXT_PUBLIC_WISE_AFFILIATE=
NEXT_PUBLIC_REVOLUT_AFFILIATE=
NEXT_PUBLIC_1ST_FORMATIONS_AFFILIATE=
NEXT_PUBLIC_FREEAGENT_AFFILIATE=

# ---- 认证（分阶段启用：默认游客可查，登录仅解锁高级功能）----
# 方案 A：Clerk（推荐）—— 5 分钟接入，前 10,000 MAU 免费。
# Dashboard → API Keys 获取两个 key 后即可启用 Google / 邮箱免密登录。
# 未配置时站点自动运行"游客模式"，所有查询照常可用。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# 开发/演示会话（默认开发环境自动开启；生产如需演示置 1）
AUTH_DEMO_MODE=0
# 管理后台管理员邮箱白名单（逗号分隔；/admin 与 /admin/customers 仅这些邮箱可见）
ADMIN_EMAILS=ai@qxx.uk

# ---- 收款：Lemon Squeezy（推荐主渠道）----
# 店铺固定链接前缀，如 https://qxxuk.lemonsqueezy.com
LEMONSQUEEZY_CHECKOUT_PREFIX=
# 店铺 ID（Dashboard → Settings → Store）
LEMONSQUEEZY_STORE_ID=
# API Key（若想用 API 动态创建 checkout，否则只需固定链接 + variant）
LEMONSQUEEZY_API_KEY=
# Webhook 签名密钥（Dashboard → Settings → Webhooks）
LEMONSQUEEZY_WEBHOOK_SECRET=
# 各套餐的 Variant ID（配好商品后回填）
LEMONSQUEEZY_VARIANT_API_STARTER=
LEMONSQUEEZY_VARIANT_ACCOUNTANT_PRO=
LEMONSQUEEZY_VARIANT_CREDIT_PACK=
LEMONSQUEEZY_VARIANT_LEAD_EXPORT=

# ---- 收款备选：Stripe ----
# 使用 Payment Link 即可（无需服务端 SDK）
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_API_STARTER=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ACCOUNTANT_PRO=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_CREDIT_PACK=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_LEAD_EXPORT=
# 若要 webhook 验签同步订单
STRIPE_WEBHOOK_SECRET=
# 价格 ID（Mapping 用）
STRIPE_PRICE_API_STARTER=
STRIPE_PRICE_ACCOUNTANT_PRO=
STRIPE_PRICE_CREDIT_PACK=
STRIPE_PRICE_LEAD_EXPORT=

# ---- 邮件提醒（申报临期）----
# 建议：Resend / Postmark。配置后可启用 /api/notifications/send-due 定时任务
RESEND_API_KEY=
EMAIL_FROM=qxx.uk <alerts@qxx.uk>